{
  "name": "corelbydre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CorelByDre — a progressive web app for professional vector illustration, page layout and photo editing. 100% client-side, offline-first, no AI/ML features.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "assemblyscript": "^0.27.31",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
